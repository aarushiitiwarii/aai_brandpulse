# Shared team settings. Do NOT put your Groq key here: create a file named .env.local next to
# this one containing one line:  GROQ_API_KEY=gsk_...   (free key: https://console.groq.com/keys)
# .env.local is git-ignored, so each teammate uses their own key and quota.
GROQ_API_KEY=
# Optional overrides
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_SMART_MODEL=openai/gpt-oss-120b
# Stretch goal: Reddit live source (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=brand-monitor/0.1
